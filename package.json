{
  "name": "tracerinfo",
  "version": "1.0.0",
  "description": "Professional OSINT CLI tool for gathering and organizing publicly available information",
  "type": "module",
  "files": [
    "dist/**",
    "drizzle/**",
    "README.md"
  ],
  "bin": {
    "tracerinfo": "./dist/index.js"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc",
    "package:deb": "bash packaging/build-deb.sh",
    "dev": "node --import tsx/esm src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx/esm src/storage/migrate.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.6.2",
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.8",
    "ora": "^8.0.1",
    "undici": "^6.11.1",
    "zod": "^3.23.4"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@vitest/coverage-v8": "^1.5.0",
    "drizzle-kit": "^0.21.2",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
