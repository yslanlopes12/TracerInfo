# TracerInfo Environment Configuration

# Path to the SQLite database file
DATABASE_PATH=./tracerinfo.db

# Request timeout in milliseconds (default: 10000)
REQUEST_TIMEOUT=10000

# Minimum interval between requests to the same provider (default: 1500 ms)
REQUEST_INTERVAL_MS=1500

# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL=3600

# Log level: silent | error | warn | info | debug
LOG_LEVEL=info

# --- API Keys (Add your own keys below) ---

# Example: Google Custom Search API
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=
